# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

# --- Supabase Postgres --------------------------------------------------------
# DATABASE_URL = koneksi lewat connection pooler (PgBouncer, port 6543) — dipakai
# runtime app (Next.js/serverless-friendly). Ambil dari Supabase Dashboard >
# Project Settings > Database > Connection string > "Transaction" pooling mode.
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# DIRECT_URL = koneksi langsung (port 5432) — dipakai HANYA oleh `prisma migrate`/`prisma db push`,
# karena PgBouncer transaction-mode tidak kompatibel dengan sebagian perintah migrasi.
DIRECT_URL="postgresql://postgres.xxxxxxxxxxxx:PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Auth ----------------------------------------------------------------------
# Wajib di-set, tidak boleh ada fallback hardcoded (section 7). Generate mis. dengan:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_STRONG_RANDOM_SECRET"

# --- Seed admin (section 7 — admin di-seed manual, bukan self-register) --------
ADMIN_NAME="Admin"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="REPLACE_WITH_STRONG_PASSWORD"

# --- Cloudinary (section 5) -----------------------------------------------------
# API Secret HANYA di server, jangan pernah expose ke client.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
